# Viral Clipper — Environment Variables Template
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# ==============================================================================
# 1. Google Gemini API (Required for AI clip discovery, virality scoring & EDL)
# Free Tier available at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 2. Groq Cloud Whisper API (Optional — fast ~15s cloud transcription)
# Free Tier available at: https://console.groq.com/keys
# If left empty, the app automatically falls back to local faster-whisper.
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# 3. Pexels API (Optional — stock B-roll for Script-to-Video faceless studio)
# Free Tier available at: https://www.pexels.com/api/
# ==============================================================================
# PEXELS_API_KEY=your_pexels_api_key_here

# ==============================================================================
# 4. Ollama Local LLM (Optional — local fallback for scoring and EDL planning)
# Defaults to http://localhost:11434
# ==============================================================================
# OLLAMA_URL=http://localhost:11434

# ==============================================================================
# 5. Render Engine Performance Tuning
# ==============================================================================
# CLIPPER_X264_PRESET=medium

